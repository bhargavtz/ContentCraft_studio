# Local environment settings. Fill these with your own development values.
# Never commit real credentials.
Auth0__Domain=your-auth0-domain
Auth0__ClientId=your-auth0-client-id
Auth0__ClientSecret=replace-with-local-secret
Auth0__CallbackUrl=https://localhost:5001/callback
Gemini__ApiKey=replace-with-gemini-api-key
MongoDb__ConnectionString=mongodb://localhost:27017/ContentCraft
